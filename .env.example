# Copy to .env, replace the password, then: set -a; source .env; set +a
POSTGRES_USER=procureiq
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=procureiq
POSTGRES_PORT=55439
DATABASE_URL=postgresql+psycopg://procureiq:replace_with_a_local_password@127.0.0.1:55439/procureiq
# Dedicated disposable database; never point at the project database.
TEST_DATABASE_URL=postgresql+psycopg://procureiq:replace_with_a_local_password@127.0.0.1:55439/procureiq_test
